# Copy to the repository root as .env and replace every placeholder.
# Passwords must be hex only (no @, :, or /) so the Redis URL stays valid.
#   openssl rand -hex 24

REDIS_PASSWORD=replace-with-openssl-rand-hex-24
ADMIN_USERNAME=librarian
ADMIN_PASSWORD=replace-with-a-long-password
CREATE_ADMIN_USER=true

# From `id -u` and `id -g` on the Pi.
PUID=1000
PGID=1000

# Pi LAN address, so port 443 is not bound on every interface.
# Example: 192.168.1.20
LAN_BIND=192.168.1.20
